{
  "name": "clinicasv-frontend",
  "version": "1.0.0",
  "description": "SPA + PWA con Web Components puros para ClinicaSV",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npx http-server . -p 5500 -c-1 --cors",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.js tests/integration/*.test.js"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}